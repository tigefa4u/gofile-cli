// @generated by usage-spec-typer from Typer metadata
name gofile-cli
bin gofile-cli
version "1.0.5"
about "Manage files and folders on Gofile from the command line."
long_about "Manage files and folders on Gofile from the command line."
flag "-t --token" help="Gofile account token. Also $GOFILE_API_TOKEN or .env." {
    arg <TOKEN>
}
cmd upload help="Upload one or more files or folders to Gofile." {
    flag "-f --folder-id" help="Destination folder UUID. Omit to create a new public folder at account root." {
        arg <FOLDER_ID>
    }
    flag "-r --recursive" help="Upload files in subfolders too."
    flag --region help="Upload region (auto, eu-par, na-phx, na-nyc, ap-sgp, ap-hkg, ap-tyo, ap-syd, sa-sao). Default is the closest region." {
        arg <REGION>
    }
    flag --guest help="Upload without an account. Prints the new guest token and reuses it for every file in the batch. Refuses when a token is set."
    flag --timeout help="Request timeout in seconds." default="120.0" {
        arg <TIMEOUT>
    }
    arg <paths>… help="File(s) or folder(s) to upload." var=#true
}
cmd whoami help="Print the current account's full details."
cmd mkdir help="Alias for 'contents create-folder'." {
    flag "-n --name" help="Folder display name. Omit to auto-generate." {
        arg <NAME>
    }
    flag --public negate=--private help="Shareable by link. Omit to inherit parent."
    arg <parent_folder_id> help="Parent folder UUID (root folder UUID for top-level)."
}
cmd rm help="Alias for 'contents delete'." {
    flag "-y --yes" help="Confirm deletion."
    arg <contents_ids>… help="Content UUIDs to delete." var=#true
}
cmd ls help="Alias for 'contents get'." {
    flag --password help="SHA-256 hash of folder password." {
        arg <PASSWORD>
    }
    flag --page help="Page number (1-based)." {
        arg <PAGE>
    }
    flag --page-size help="Items per page." {
        arg <PAGE_SIZE>
    }
    flag --sort-field help=createTime|name|size|downloads|mimetype. {
        arg <SORT_FIELD>
    }
    flag --sort-direction help="1 ascending, -1 descending." {
        arg <SORT_DIRECTION>
    }
    flag --filter help="Case-insensitive substring filter on child names/tags." {
        arg <FILTER>
    }
    flag --maxdepth help="Nested children depth 1-16 (default 1)." {
        arg <MAXDEPTH>
    }
    arg <content_id> help="Folder/file UUID or share code."
}
cmd account subcommand_required=#true help="Manage Gofile accounts." {
    cmd create help="Create a Gofile account (guest if no email)." {
        flag "-e --email" help="Email for a standard, recoverable account. Omit for a guest account." {
            arg <EMAIL>
        }
    }
    cmd getid help="Resolve the account behind the current token."
    cmd show help="Show full account details." {
        arg "[account_id]" help="Account UUID. Omit to resolve from token." required=#false
    }
    cmd reset-token help="Invalidate the current token and email a new one (never for guests)." {
        flag "-y --yes" help="Confirm token reset."
        arg <account_id> help="Account UUID."
    }
}
cmd contents subcommand_required=#true help="Manage files and folders." {
    cmd create-folder help="Create a folder inside a parent folder." {
        flag "-n --name" help="Folder display name. Omit to auto-generate." {
            arg <NAME>
        }
        flag --public negate=--private help="Shareable by link. Omit to inherit parent."
        arg <parent_folder_id> help="Parent folder UUID (root folder UUID for top-level)."
    }
    cmd get help="Read a folder (metadata + children) or a single file's metadata (Premium)." {
        flag --password help="SHA-256 hash of folder password." {
            arg <PASSWORD>
        }
        flag --page help="Page number (1-based)." {
            arg <PAGE>
        }
        flag --page-size help="Items per page." {
            arg <PAGE_SIZE>
        }
        flag --sort-field help=createTime|name|size|downloads|mimetype. {
            arg <SORT_FIELD>
        }
        flag --sort-direction help="1 ascending, -1 descending." {
            arg <SORT_DIRECTION>
        }
        flag --filter help="Case-insensitive substring filter on child names/tags." {
            arg <FILTER>
        }
        flag --maxdepth help="Nested children depth 1-16 (default 1)." {
            arg <MAXDEPTH>
        }
        arg <content_id> help="Folder/file UUID or share code."
    }
    cmd update help="Update one or more attributes of a file or folder (one API call per attribute)." {
        flag --name help="New content name (max 255)." {
            arg <NAME>
        }
        flag --description help="Folder description (markdown, max 2000). Empty removes." {
            arg <DESCRIPTION>
        }
        flag --tags help="Comma-separated tags. Empty removes all." {
            arg <TAGS>
        }
        flag --public help="Make folder public/private." negate=--no-public
        flag --password help="Folder password 4-100 chars; empty removes." {
            arg <PASSWORD>
        }
        flag --expiry help="Expiration Unix timestamp; 0 removes." {
            arg <EXPIRY>
        }
        flag --mod-time help="Modification time Unix timestamp." {
            arg <MOD_TIME>
        }
        flag --delete-after-expiry help="Premium: permanently delete on expiry. Requires --expiry."
        arg <content_id> help="Content UUID (share codes not accepted)."
    }
    cmd delete help="Delete files and/or folders (recursive for folders)." {
        flag "-y --yes" help="Confirm deletion."
        arg <contents_ids>… help="Content UUIDs to delete." var=#true
    }
    cmd copy help="Copy files/folders into a destination folder (Premium)." {
        flag "-t --to" help="Destination folder UUID." required=#true {
            arg <TO>
        }
        flag --password help="SHA-256 hash of source password." {
            arg <PASSWORD>
        }
        arg <contents_ids>… help="Content UUIDs to copy." var=#true
    }
    cmd move help="Move files/folders into another folder (Premium)." {
        flag "-t --to" help="Destination folder UUID." required=#true {
            arg <TO>
        }
        arg <contents_ids>… help="Content UUIDs to move." var=#true
    }
    cmd import help="Import shared content into your account (Premium)." {
        flag --password help="SHA-256 hash of source password." {
            arg <PASSWORD>
        }
        arg <contents_ids>… help="Content UUIDs to import." var=#true
    }
    cmd search help="Search a folder recursively by name or tags (Premium)." {
        flag --password help="SHA-256 hash of folder password." {
            arg <PASSWORD>
        }
        flag --from help="Only content created at/after this Unix timestamp." {
            arg <FROM>
        }
        flag --to help="Only content created at/before this Unix timestamp." {
            arg <TO>
        }
        arg <content_id> help="Folder UUID or share code to search in."
        arg <searched_string> help="Text to match against names and tags."
    }
}
cmd directlinks subcommand_required=#true help="Manage direct links (Premium)." {
    cmd create help="Create a direct link (Premium)." {
        flag --expire help="Expiry Unix timestamp. Omit for never." {
            arg <EXPIRE>
        }
        flag --ip help="Allowed IPv4 (repeatable)." var=#true {
            arg <IP>
        }
        flag --domain-allowed help="Allowed referring domain (repeatable)." var=#true {
            arg <DOMAIN_ALLOWED>
        }
        flag --domain-blocked help="Blocked referring domain (repeatable)." var=#true {
            arg <DOMAIN_BLOCKED>
        }
        flag --auth help="HTTP basic auth 'user:pass' (repeatable)." var=#true {
            arg <AUTH>
        }
        arg <content_id> help="Content UUID."
    }
    cmd update help="Update a direct link (Premium). Omitted fields keep their current value." {
        flag --expire help="New expiry Unix timestamp; 4102444800 = never." {
            arg <EXPIRE>
        }
        flag --ip help="Replacement IPv4 allowlist (repeatable)." var=#true {
            arg <IP>
        }
        flag --domain-allowed help="Replacement allowed domains (repeatable)." var=#true {
            arg <DOMAIN_ALLOWED>
        }
        flag --domain-blocked help="Replacement blocked domains (repeatable)." var=#true {
            arg <DOMAIN_BLOCKED>
        }
        flag --auth help="Replacement 'user:pass' pairs (repeatable)." var=#true {
            arg <AUTH>
        }
        flag --clear-ips help="Remove IP allowlist."
        flag --clear-domains-allowed help="Remove allowed domains."
        flag --clear-domains-blocked help="Remove blocked domains."
        flag --clear-auth help="Remove auth."
        arg <content_id> help="Content UUID."
        arg <direct_link_id> help="Direct link UUID."
    }
    cmd delete help="Delete a direct link (Premium)." {
        flag "-y --yes" help="Confirm deletion."
        arg <content_id> help="Content UUID."
        arg <direct_link_id> help="Direct link UUID."
    }
}

